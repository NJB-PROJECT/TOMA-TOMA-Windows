<Application x:Class="Toma.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#181922"/><SolidColorBrush x:Key="Accent" Color="#C8BCFF"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#101116"/><Setter Property="Foreground" Value="#F3F2F8"/></Style>
  <Style TargetType="TextBlock"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EFEDF9"/><Setter Property="Background" Value="#272833"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#22232E"/><Setter Property="Foreground" Value="#F3F2F8"/><Setter Property="CaretBrush" Value="#C8BCFF"/><Setter Property="BorderBrush" Value="#3E3D4D"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D8D4E9"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#181322"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EDECF4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 </Application.Resources>
</Application>
