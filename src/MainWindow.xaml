<Window x:Class="Toma.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Toma.Windows" Style="{StaticResource {x:Type Window}}" Title="TOMA TOMA · Windows" Width="1080" Height="780" MinWidth="800" MinHeight="540" WindowStartupLocation="CenterScreen">
 <Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,4,28,0"><TextBlock Text="toma toma" FontWeight="Bold" FontSize="31"/><TextBlock Text="WINDOWS / 01" Foreground="#A798DE" FontSize="11" Margin="1,8,0,25"/>
   <TextBlock Text="Musikmu.&#x0a;Lirikmu." FontSize="27" FontWeight="Light" Margin="0,0,0,28"/>
   <Button Content="Ikuti pemutar Windows" Click="FollowClick" Margin="0,0,0,10"/><Button Content="Buka file audio" Click="LocalClick" Margin="0,0,0,10"/><Button Content="Buka link musik" Click="LinkClick" Margin="0,0,0,10"/><Button Content="Impor lirik .LRC" Click="ImportClick" Margin="0,0,0,25"/>
   <CheckBox x:Name="IslandCheck" Content="Island di atas monitor" Checked="IslandChanged" Unchecked="IslandChanged"/><CheckBox x:Name="SpectrumCheck" Content="Spektrum audio nyata" Checked="SpectrumChanged" Unchecked="SpectrumChanged"/>
   <Button Content="✦ Personalisasi island" Click="AppearanceClick" Margin="0,14,0,0" ToolTip="Tema terpisah untuk kapsul kecil dan kartu besar"/>
   <TextBlock Text="MONITOR ISLAND" FontSize="10" Foreground="#9A96AB" Margin="0,20,0,8"/><ComboBox x:Name="MonitorBox" SelectionChanged="MonitorChanged" Padding="8"/>
   <TextBlock Text="Klik luar tetap terbuka.&#x0a;Swipe kartu ke atas untuk mengecilkan.&#x0a;Klik kapsul untuk memperbesar." Foreground="#9693A8" TextWrapping="Wrap" FontSize="12" Margin="0,15,0,15"/>
   <TextBlock Text="Spektrum membaca keluaran audio sistem, bukan mikrofon. Audio tidak direkam ke file atau diunggah." Foreground="#9693A8" TextWrapping="Wrap" FontSize="11"/>
  </StackPanel></ScrollViewer>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#1C1D29" CornerRadius="22" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#2A2739" CornerRadius="14" Width="90" Height="90"><Grid><TextBlock Text="♫" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C8BCFF"/><Image x:Name="Art" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center"><TextBlock Text="SEDANG DIPUTAR" Foreground="#A798DE" FontSize="10" Margin="0,0,0,7"/><TextBlock x:Name="TrackTitle" Text="Putar musikmu" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="TrackArtist" Text="Spotify · YouTube Music · pemutar Windows" Foreground="#B8B2CA" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
   <StackPanel Grid.Row="1" Margin="0,16,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⏮" Click="PreviousClick"/><Button x:Name="PlayButton" Content="▶ Putar" Click="PlayClick" Background="#C8BCFF" Foreground="#171322"/><Button Content="⏭" Click="NextClick"/><TextBlock x:Name="Clock" Text="00:00 / 00:00" VerticalAlignment="Center" Foreground="#B9B4CC" Margin="6,0"/></StackPanel><local:SpectrumView Grid.Column="1" Height="58" Width="140"/></Grid><TextBlock x:Name="StateLabel" Text="Menunggu metadata pemutar…" Foreground="#9F98B6" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
   <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TitleInput" ToolTip="Judul lagu" Margin="0,0,8,0"/><TextBox Grid.Column="1" x:Name="ArtistInput" ToolTip="Artis" Margin="0,0,8,0"/><Button Grid.Column="2" Content="Cari lirik" Click="SearchClick" Margin="0"/></Grid>
   <Border Grid.Row="3" Background="#181922" CornerRadius="20" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Pilih versi" Click="VersionClick" FontSize="11" Padding="10,5" Margin="0"/><TextBlock x:Name="Provider" Text="LIRIK SAAT INI" Foreground="#AEDEC8" FontSize="11" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="1"><TextBlock x:Name="EmptyLyrics" Text="Lirik mengikuti lagu yang kamu putar.&#x0a;&#x0a;Mulai musik di pemutar yang menyediakan sesi media Windows, atau buka file audio lokal." FontSize="21" Foreground="#A6A0B6" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4"/>
     <ListBox x:Name="LyricsList" SelectionChanged="LineSelected" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#868096"/><Setter Property="Padding" Value="6,10"/><Setter Property="FontSize" Value="18"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#D5C9FF"/><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid><TextBlock x:Name="Credit" Grid.Row="2" Text="Auto Lyrics By MNajibRamadhan" Foreground="#C8BCFF" FontSize="11" Margin="6,15,0,0"/>
   </Grid></Border>
   <DockPanel Grid.Row="4" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−250 ms" Click="OffsetBack" FontSize="11" Padding="8,6"/><TextBlock x:Name="OffsetLabel" Text="0 ms" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/><Button Content="+250 ms" Click="OffsetAhead" FontSize="11" Padding="8,6" Margin="0"/></StackPanel><CheckBox x:Name="FollowCheck" Content="Ikuti baris aktif" IsChecked="True"/><TextBlock Text="  ·  Koreksi waktu lirik" VerticalAlignment="Center" FontSize="11" Foreground="#8D879C"/></DockPanel>
  </Grid>
 </Grid>
</Window>
