<Window x:Class="Toma.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Toma.Windows" Style="{StaticResource {x:Type Window}}" Title="Lyrivane Desktop" Icon="Assets/Lyrivane.ico" Width="1080" Height="780" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/Lyrivane.png" Width="46" Height="46" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Lyrivane" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="D E S K T O P   /   LIVE LYRICS" Foreground="#78EBCB" FontSize="9" Margin="1,3,0,0"/></StackPanel></StackPanel><TextBlock Text="Musik mengalir. Lirik mengikuti." Foreground="#91A6B8" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border CornerRadius="22" Padding="20" BorderBrush="#263744" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B3440"/><GradientStop Color="#121B25" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel>
     <TextBlock Text="NOW PLAYING" Foreground="#78EBCB" FontSize="10" Margin="0,0,0,14"/>
     <Border Height="140" Background="#0D1923" CornerRadius="14" ClipToBounds="True"><Grid><Image Source="Assets/Lyrivane.png" Width="100" Opacity="0.4"/><Image x:Name="Art" Stretch="UniformToFill"/></Grid></Border>
     <TextBlock x:Name="TrackTitle" Text="Putar musikmu" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,6"/><TextBlock x:Name="TrackArtist" Foreground="#A7BDCB" TextWrapping="Wrap" FontSize="12"/>
     <TextBlock x:Name="Clock" Text="00:00 / 00:00" Foreground="#91A6B8" FontSize="11" Margin="0,16,0,10"/>
     <UniformGrid Columns="3"><Button Content="⏮" Click="PreviousClick" ToolTip="Lagu sebelumnya"/><Button x:Name="PlayButton" Content="▶ Putar" Click="PlayClick" Background="#78EBCB" Foreground="#09251E" Padding="8,12"/><Button Content="⏭" Click="NextClick" Margin="0" ToolTip="Lagu berikutnya"/></UniformGrid>
     <local:SpectrumView BandCount="22" Height="48" Margin="0,15,0,0" ToolTip="Spektrum nyata keluaran audio Windows · stereo L/R"/>
    </StackPanel></Border>
    <TextBlock Text="SUMBER MUSIK" FontSize="10" Foreground="#7893A5" Margin="4,22,0,10"/>
    <Button Content="↗  Hubungkan pemutar Windows" Click="FollowClick" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
    <UniformGrid Columns="2"><Button Content="File audio" Click="LocalClick"/><Button Content="Link musik" Click="LinkClick" Margin="0"/></UniformGrid>
    <TextBlock x:Name="StateLabel" Text="Menunggu pemutar…" TextWrapping="Wrap" FontSize="11" Foreground="#93AAB9" Margin="4,12,4,14"/>
    <Expander Header="Island &amp; pengaturan" Foreground="#D7E8EF" Padding="3" IsExpanded="False"><StackPanel Margin="0,10,0,0"><CheckBox x:Name="IslandCheck" Content="Island di atas monitor" Checked="IslandChanged" Unchecked="IslandChanged"/><CheckBox x:Name="SpectrumCheck" Content="Spektrum audio nyata" Checked="SpectrumChanged" Unchecked="SpectrumChanged"/><Button Content="Warna &amp; background island" Click="AppearanceClick" Margin="0,8,0,12"/><TextBlock Text="MONITOR" FontSize="10" Foreground="#91A6B8" Margin="0,0,0,6"/><ComboBox x:Name="MonitorBox" SelectionChanged="MonitorChanged" Padding="8"/><TextBlock Text="Klik kapsul untuk membuka. Swipe ke atas untuk mengecilkan. Klik di luar tidak menutup kartu." TextWrapping="Wrap" FontSize="11" Foreground="#91A6B8" Margin="0,12,0,8"/><TextBlock Text="Audio dianalisis di perangkat, tanpa disimpan atau diunggah." TextWrapping="Wrap" Foreground="#7893A5" FontSize="10"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="2" Background="#121B25" BorderBrush="#263744" BorderThickness="1" CornerRadius="22" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Pilih versi ↗" Click="VersionClick" FontSize="11" Margin="0" Padding="12,8"/><StackPanel><TextBlock Text="Ruang lirik" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="Provider" Text="LIVE LYRICS" Foreground="#78EBCB" FontSize="10" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
    <Expander Grid.Row="1" Header="Cari ulang atau impor lirik" Foreground="#91A6B8" Margin="0,0,0,14"><StackPanel Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="TitleInput" ToolTip="Judul lagu" Margin="0,0,8,0"/><TextBox Grid.Column="1" x:Name="ArtistInput" ToolTip="Nama artis"/></Grid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Cari lirik" Click="SearchClick"/><Button Content="Impor .LRC" Click="ImportClick"/></StackPanel></StackPanel></Expander>
    <Grid Grid.Row="2"><TextBlock x:Name="EmptyLyrics" Text="Setiap lagu punya cerita.&#x0a;Temukan liriknya di sini.&#x0a;&#x0a;Putar musik di Spotify, YouTube Music, atau buka file audio untuk mulai." FontSize="23" Foreground="#91A6B8" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8"/>
     <ListBox x:Name="LyricsList" SelectionChanged="LineSelected" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="False"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#78909F"/><Setter Property="Padding" Value="12,13"/><Setter Property="FontSize" Value="24"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#A5FFE5"/><Setter Property="Background" Value="#1A3338"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,16,0,0"><Border Height="1" Background="#263744" Margin="0,0,0,12"/><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−250" Click="OffsetBack" FontSize="10" Padding="8,6" ToolTip="Lirik lebih awal 250 ms"/><TextBlock x:Name="OffsetLabel" Text="0 ms" VerticalAlignment="Center" Foreground="#A5BCCB" FontSize="10" Margin="0,0,8,0"/><Button Content="+250" Click="OffsetAhead" FontSize="10" Padding="8,6" Margin="0" ToolTip="Lirik lebih lambat 250 ms"/></StackPanel><CheckBox x:Name="FollowCheck" Content="Ikuti lirik" IsChecked="True" FontSize="11"/></DockPanel><TextBlock x:Name="Credit" Text="Auto Lyrics By MNajibRamadhan" FontSize="10" Margin="0,10,0,0" Foreground="#78EBCB"/></StackPanel>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>
