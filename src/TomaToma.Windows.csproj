<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Lyrivane</AssemblyName><RootNamespace>Toma.Windows</RootNamespace><Version>2.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets/Lyrivane.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1"/></ItemGroup>
  <ItemGroup><Compile Remove="obj/**/*.cs;bin/**/*.cs" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Lyrivane.png" /><Resource Include="Assets/Lyrivane.ico" /></ItemGroup>
</Project>
